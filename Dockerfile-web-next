# Independent static Vue 3 candidate image. Build from the repository root.
FROM node:22.23.1-alpine AS build
WORKDIR /app
COPY main/manager-web-next/package.json main/manager-web-next/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY main/manager-web-next/index.html main/manager-web-next/vite.config.js ./
COPY main/manager-web-next/src ./src
COPY main/manager-web-next/public ./public
COPY main/manager-web-next/scripts ./scripts
ARG VITE_API_BASE_URL=/xiaozhi
ARG VITE_CONVERSATION_ENABLED=true
ARG VITE_ENV_LABEL="Dev Vue 3"
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY dev/nginx-vue3.conf.template /etc/nginx/templates/default.conf.template
ENV API_PROXY_TARGET=http://api:8002
ENV NGINX_ENVSUBST_FILTER=^API_PROXY_TARGET$
EXPOSE 8080
