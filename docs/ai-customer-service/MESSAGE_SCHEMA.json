{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xiaozhi:conversation:send-message:v1",
  "title": "P1/B1/B2 user SendMessage wire schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_message_id",
    "parts"
  ],
  "properties": {
    "client_message_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/TextPart"
          },
          {
            "$ref": "#/$defs/LocationPart"
          },
          {
            "$ref": "#/$defs/AttachmentPart"
          }
        ]
      }
    }
  },
  "$defs": {
    "TextPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "LocationPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "latitude",
        "longitude",
        "coordinate_system",
        "accuracy_m",
        "source",
        "authorized_at"
      ],
      "properties": {
        "type": {
          "const": "location"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "coordinate_system": {
          "enum": [
            "WGS84",
            "GCJ02"
          ]
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "source": {
          "const": "user_shared"
        },
        "authorized_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AssistantTextPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256000
        }
      },
      "description": "Persisted response only. Long assistant output is not a user SendMessage request; queued/reset placeholders may have an empty parts array."
    },
    "TokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Actual provider usage, or null on the enclosing Run/complete field. No fabricated or estimated tokens."
    },
    "AiEventData": {
      "type": "object",
      "required": [
        "run_id",
        "message_id",
        "attempt"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "seq": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "chunk_sequence": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "text": {
          "type": "string"
        },
        "error_code": {
          "type": "string"
        }
      },
      "description": "B2 payload within the existing ConversationEvent envelope. Delta additionally requires chunk_sequence/text; created includes message seq. Reset clears prior attempt text; queued retry can retain partial text until next claim/reset. Sequence dedup uses envelope.sequence, not message seq."
    },
    "AttachmentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "attachment_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "image",
            "video",
            "audio",
            "file"
          ]
        },
        "attachment_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Positive Java signed long decimal string, at most 9223372036854775807."
        }
      },
      "description": "B3: ready attachment owned by sender, in same conversation, linked once in the message transaction; at most 10 attachments, one video and one audio per message."
    }
  },
  "description": "Implemented user requests support text and location; B1 support sends remain text-only. B2 does not accept model, owner, sender, run or lease fields from clients. Saving an AI_ACTIVE user message may enqueue an AI run when the default-off AI-text feature is explicitly enabled. Request TextPart remains bounded at 8000 characters; persisted assistant responses use AssistantTextPart. AI usage is actual provider-reported data, never an estimate; legacy read-only history is not imported into this request or model context. B3 adds AttachmentPart for user and current support sender when attachments are enabled; location remains unavailable to support sends. Attachment IDs are positive Java long decimal strings; conversation IDs remain 32 lowercase hex."
}
